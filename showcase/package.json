{
  "name": "appunti-vision-desktop",
  "version": "1.0.1",
  "description": "Appunti Vision come applicazione desktop per PC",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "npm run build && node electron/launch.cjs .",
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 node electron/launch.cjs .\"",
    "build": "vite build",
    "preview": "vite preview",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.appuntivision.desktop",
    "productName": "Appunti Vision",
    "files": [
      "dist/**/*",
      "icons/**/*",
      "electron/**/*",
      "styles.css",
      "styles/**/*"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    },
    "mac": {
      "target": "dmg"
    }
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.3"
  }
}
