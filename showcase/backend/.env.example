APPUNTI_ENV=development
APPUNTI_DEBUG=true
APPUNTI_HOST=127.0.0.1
APPUNTI_PORT=8443
APPUNTI_RELOAD=true
APPUNTI_USE_HTTPS=true
APPUNTI_SSL_CERTFILE=./certs/dev-cert.pem
APPUNTI_SSL_KEYFILE=./certs/dev-key.pem
APPUNTI_SECRET_KEY=change-me-in-production
APPUNTI_ACCESS_TOKEN_EXPIRE_MINUTES=120
APPUNTI_DATABASE_URL=mysql+pymysql://appunti:appunti@127.0.0.1:3306/appunti_backend
APPUNTI_ALLOWED_ORIGINS=https://localhost:5173,https://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5173
APPUNTI_BOOTSTRAP_SCHEMA_ON_STARTUP=true
APPUNTI_UPLOAD_DIR=./data/uploads
APPUNTI_MAX_UPLOAD_SIZE_MB=512
